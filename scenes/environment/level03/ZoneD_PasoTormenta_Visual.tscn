[sub_resource type="Shader" id="Shader_rain_transition"]
code = "shader_type canvas_item;\n\nuniform float speed = 0.68;\n\nvoid fragment() {\n    vec2 uv = UV;\n    uv.y = fract(uv.y - TIME * speed);\n    COLOR = texture(TEXTURE, uv) * COLOR;\n}\n"

